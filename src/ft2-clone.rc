			VALUE "InternalName",     "Tapehead"
			VALUE "OriginalFilename", "Tapehead.exe"
			VALUE "LegalCopyright",   "Copyright (c) Olav ""8bitbubsy"" Sorensen"
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END

IDI_MAIN_ICON ICON "gfxdata\\icon\\tapehead\\tapehead.ico"
